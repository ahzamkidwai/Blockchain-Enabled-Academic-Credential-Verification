# --- Compiler & Build Artifacts ---
out/
cache/
artifacts/
build/

# --- Dependencies ---
# Foundry uses git submodules in /lib (keep tracked)
node_modules/
pnpm-lock.yaml
package-lock.json
yarn.lock

# --- Foundry Specific ---
# Broadcast & script outputs
broadcast/
!/broadcast/**/README.md

# Ignore local chain & dry runs
/broadcast/*/31337/
/broadcast/**/dry-run/

# Ignore sensitive or noisy tx data
/broadcast/*/run-latest.json
/broadcast/*/run-*.json

# --- Testing & Coverage ---
.gas-snapshot
coverage/
lcov.info

# Forge traces (optional, uncomment if generated)
# traces/

# --- Security & Environment ---
.env
.env.*
!.env.example

# Keystore / private keys (extra safety)
*.key
*.pem
*.p12
*.keystore

# --- Logs ---
*.log

# --- Documentation ---
docs/

# --- IDE & Editor ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

.idea/

# Vim
*.swp
*.swo

# --- OS Files ---
.DS_Store
Thumbs.db

# --- Misc ---
# Temporary files
tmp/
temp/

# Cache
*.cache